# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (formerly "service_role"). Server-only, NEVER prefix with NEXT_PUBLIC_.
# Used only in the admin user-creation route and the cron route.
SUPABASE_SECRET_KEY=

# Web Push (generate with: node scripts/generate-vapid-keys.mjs)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:jorgealejandrotapiaahumada@gmail.com

# Random secret shared with vercel.json's cron config, checked by /api/cron/check-vencimientos
CRON_SECRET=
